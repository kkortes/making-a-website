{
  "name": "making-a-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "../dev.sh 'bunx --bun vite --port $PORT --strictPort'",
    "build": "vibe compile && bun steps.js"
  },
  "dependencies": {
    "@ape-egg/codie": "^0.1.13",
    "@ape-egg/vibe": "^4.3.15"
  },
  "devDependencies": {
    "@ape-egg/vibe-compiler": "^4.3.15",
    "@ape-egg/vite-plugin-vibe": "^0.5.0",
    "vite": "^8.3.3"
  },
  "vibe-compiler": {
    "elementsAsIs": true,
    "nodeModulesAsIs": true,
    "skipFiles": ["vite.config.js", "steps.js", "steps", "package.json", "bun.lock"]
  }
}
